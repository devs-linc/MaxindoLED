---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import Breadcrumb from '../../../components/schema/Breadcrumb.astro';
import { localizedPath } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/ui';
import { SITE } from '../../../consts';

export function getStaticPaths() {
  return [{ params: { lang: 'id' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;

const services = (await getCollection('services'))
  .filter((e) => e.id.startsWith(lang + '/'))
  .map((e) => ({ ...e, slug: e.id.slice(lang.length + 1) }))
  .sort((a, b) => a.data.order - b.data.order);

const copy = {
  id: {
    eyebrow: 'Layanan Kami',
    title: 'Layanan Audio Visual & Multimedia',
    intro:
      'Maxindo LED adalah penyedia solusi audio visual satu pintu di Tangerang dan Jakarta. Dari sewa LED screen, sound system, dan lighting hingga produksi teknis acara, instalasi permanen, dan penjualan peralatan — kami siap mewujudkan acara Anda dengan standar profesional.',
    cta: 'Butuh rekomendasi layanan yang tepat?',
    learnMore: 'Selengkapnya',
    breadcrumbHome: 'Beranda',
    breadcrumbServices: 'Layanan',
  },
  en: {
    eyebrow: 'Our Services',
    title: 'Audio Visual & Multimedia Services',
    intro:
      'Maxindo LED is a single-source audio visual solutions provider in Tangerang and Jakarta. From LED screen, sound system, and lighting rental to technical event production, permanent installation, and equipment sales — we are ready to bring your event to life to professional standards.',
    cta: 'Need help choosing the right service?',
    learnMore: 'Learn more',
    breadcrumbHome: 'Home',
    breadcrumbServices: 'Services',
  },
}[lang];

const title = `${copy.title} | Maxindo LED`;
const description = copy.intro.slice(0, 158);

const breadcrumbItems = [
  { name: copy.breadcrumbHome, url: `${SITE.url}${localizedPath(lang, '/')}` },
  {
    name: copy.breadcrumbServices,
    url: `${SITE.url}${localizedPath(lang, '/services/')}`,
  },
];

const ctaMessage =
  lang === 'id'
    ? 'Halo Maxindo LED, saya ingin berkonsultasi mengenai layanan audio visual untuk acara saya.'
    : 'Hello Maxindo LED, I would like to consult about audio visual services for my event.';
---

<Base title={title} description={description} lang={lang}>
  <Breadcrumb slot="head" items={breadcrumbItems} />

  <section class="container-x py-16 md:py-24">
    <div class="max-w-3xl">
      <span
        class="inline-block rounded-full border border-accent/40 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-accent"
      >
        {copy.eyebrow}
      </span>
      <h1
        class="mt-5 bg-accent-grad bg-clip-text text-4xl font-extrabold leading-tight text-transparent md:text-5xl"
      >
        {copy.title}
      </h1>
      <p class="mt-5 text-lg text-muted">{copy.intro}</p>
    </div>

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <li>
            <a
              href={localizedPath(lang, '/services/' + service.slug)}
              class="group flex h-full flex-col rounded-xl border border-white/10 bg-surface p-6 transition hover:border-accent/50"
            >
              <h2 class="text-xl font-bold text-white group-hover:text-accent">
                {service.data.name}
              </h2>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">
                {service.data.description}
              </p>
              <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-accent">
                {copy.learnMore}
                <span aria-hidden="true" class="transition group-hover:translate-x-1">
                  &rarr;
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div
      class="mt-14 flex flex-col items-start gap-5 rounded-xl border border-white/10 bg-surface p-8 md:flex-row md:items-center md:justify-between"
    >
      <p class="text-lg font-semibold text-white">{copy.cta}</p>
      <WhatsAppButton lang={lang} message={ctaMessage} />
    </div>
  </section>
</Base>
