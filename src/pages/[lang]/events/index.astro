---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import Breadcrumb from '../../../components/schema/Breadcrumb.astro';
import { localizedPath } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/ui';
import { SITE } from '../../../consts';

export function getStaticPaths() {
  return [{ params: { lang: 'id' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;

// Load this locale's event types and strip the "<lang>/" prefix from the id.
const all = await getCollection('eventTypes');
const events = all
  .filter((e) => e.id.startsWith(`${lang}/`))
  .map((e) => ({
    slug: e.id.slice(lang.length + 1),
    name: e.data.name,
    description: e.data.description,
    image: e.data.image,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const copy =
  lang === 'id'
    ? {
        eyebrow: 'Jenis Acara',
        title: 'Solusi LED & Audio Visual untuk Setiap Acara',
        intro:
          'Setiap acara punya kebutuhan teknis yang berbeda. Pilih jenis acara Anda untuk melihat rekomendasi LED screen, sound system, dan lighting yang paling sesuai dari Maxindo LED.',
        explore: 'Lihat detail',
        ctaHeading: 'Tidak menemukan acara Anda?',
        ctaText:
          'Ceritakan kebutuhan Anda kepada tim kami dan dapatkan rancangan setup serta penawaran harga gratis.',
        home: 'Beranda',
        events: 'Acara',
      }
    : {
        eyebrow: 'Event Types',
        title: 'LED & Audio Visual Solutions for Every Event',
        intro:
          'Every event has different technical needs. Choose your event type to see the LED screen, sound system, and lighting recommendations that fit best from Maxindo LED.',
        explore: 'View details',
        ctaHeading: 'Don’t see your event?',
        ctaText:
          'Tell our team about your needs and get a free setup design and price quote.',
        home: 'Home',
        events: 'Events',
      };

const title = `${copy.title} | Maxindo LED`;
const description = copy.intro.slice(0, 160);

const base = Astro.site ?? SITE.url;
const crumbs = [
  { name: copy.home, url: new URL(localizedPath(lang, '/'), base).href },
  { name: copy.events, url: new URL(localizedPath(lang, '/events'), base).href },
];
---

<Base title={title} description={description} lang={lang}>
  <Breadcrumb slot="head" items={crumbs} />

  <section class="container-x py-16 md:py-24">
    <nav aria-label="Breadcrumb" class="mb-8 text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a class="transition-colors hover:text-accent" href={localizedPath(lang, '/')}>
            {copy.home}
          </a>
        </li>
        <li aria-hidden="true" class="opacity-40">/</li>
        <li class="text-ink">{copy.events}</li>
      </ol>
    </nav>

    <div class="max-w-3xl">
      <span class="eyebrow">{copy.eyebrow}</span>
      <h1 class="section-title mt-5 text-4xl md:text-5xl">{copy.title}</h1>
      <p class="lead mt-5">{copy.intro}</p>
    </div>

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        events.map((event) => (
          <li>
            <a
              href={localizedPath(lang, `/events/${event.slug}`)}
              class="card group flex h-full flex-col overflow-hidden transition-all hover:-translate-y-1 hover:border-accent hover:shadow-lg"
            >
              <div class="aspect-video overflow-hidden bg-surface">
                <Image
                  src={event.image}
                  alt={event.name}
                  width={640}
                  height={360}
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </div>
              <div class="flex flex-1 flex-col p-6">
                <h2 class="text-xl font-bold text-ink transition-colors group-hover:text-accent">
                  {event.name}
                </h2>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-body">
                  {event.description}
                </p>
                <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-accent">
                  {copy.explore}
                  <span
                    aria-hidden="true"
                    class="transition-transform group-hover:translate-x-0.5"
                  >
                    &rarr;
                  </span>
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    <div
      class="mt-16 rounded-2xl bg-cream p-8 md:flex md:items-center md:justify-between md:gap-8"
    >
      <div class="max-w-xl">
        <h2 class="text-2xl font-bold text-ink">{copy.ctaHeading}</h2>
        <p class="mt-2 text-body">{copy.ctaText}</p>
      </div>
      <div class="mt-6 md:mt-0 md:shrink-0">
        <WhatsAppButton lang={lang} />
      </div>
    </div>
  </section>
</Base>
