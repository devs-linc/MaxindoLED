---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import Breadcrumb from '../../../components/schema/Breadcrumb.astro';
import FaqPage from '../../../components/schema/FaqPage.astro';
import { localizedPath } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/ui';
import { SITE } from '../../../consts';

export async function getStaticPaths() {
  const all = await getCollection('eventTypes');
  return all.map((entry) => {
    const lang = entry.id.split('/')[0] as Lang;
    const slug = entry.id.slice(lang.length + 1);
    return { params: { lang, slug }, props: { entry } };
  });
}

const lang = Astro.params.lang as Lang;
const { entry } = Astro.props;
const { Content } = await render(entry);

const { name, description } = entry.data;
const slug = entry.id.slice(lang.length + 1);

const title =
  lang === 'id'
    ? `Sewa Peralatan untuk ${name} | Maxindo LED`
    : `Equipment Rental for ${name} | Maxindo LED`;

const copy =
  lang === 'id'
    ? {
        home: 'Beranda',
        events: 'Acara',
        recommendedHeading: 'Layanan & Peralatan yang Direkomendasikan',
        recommendedIntro: `Lengkapi acara ${name} Anda dengan layanan dan peralatan pilihan kami:`,
        services: 'Lihat semua layanan',
        equipment: 'Jelajahi katalog peralatan',
        faqHeading: 'Pertanyaan yang Sering Diajukan',
        ctaHeading: `Siap merencanakan acara ${name} Anda?`,
        ctaText:
          'Tim Maxindo LED siap membantu merancang setup dan memberikan penawaran harga gratis.',
        waMessage: `Halo Maxindo LED, saya ingin menyewa peralatan untuk acara ${name}. Mohon info paket dan harganya.`,
      }
    : {
        home: 'Home',
        events: 'Events',
        recommendedHeading: 'Recommended Services & Equipment',
        recommendedIntro: `Complete your ${name} event with our recommended services and equipment:`,
        services: 'View all services',
        equipment: 'Explore the equipment catalog',
        faqHeading: 'Frequently Asked Questions',
        ctaHeading: `Ready to plan your ${name} event?`,
        ctaText:
          'The Maxindo LED team is ready to help design your setup and provide a free price quote.',
        waMessage: `Hello Maxindo LED, I would like to rent equipment for a ${name} event. Please share package and pricing info.`,
      };

const faqs =
  lang === 'id'
    ? [
        {
          q: `Peralatan apa yang cocok untuk acara ${name}?`,
          a: `Untuk acara ${name}, kami merekomendasikan kombinasi LED screen, sound system, dan lighting yang disesuaikan dengan ukuran venue serta jumlah tamu. Tim kami akan membantu menentukan konfigurasi terbaik.`,
        },
        {
          q: `Apakah Maxindo LED melayani area sekitar Tangerang dan Jakarta?`,
          a: `Ya. Kami melayani penyewaan dan pemasangan peralatan untuk acara ${name} di Tangerang, Jakarta, dan wilayah sekitarnya, lengkap dengan kru teknis dan operator.`,
        },
        {
          q: `Bagaimana cara mendapatkan penawaran harga?`,
          a: `Cukup hubungi kami via WhatsApp dengan detail acara ${name} Anda, seperti tanggal, lokasi, dan perkiraan jumlah tamu. Kami akan mengirimkan penawaran harga gratis dan transparan.`,
        },
      ]
    : [
        {
          q: `What equipment is suitable for a ${name} event?`,
          a: `For a ${name} event, we recommend a combination of LED screens, sound systems, and lighting matched to your venue size and guest count. Our team will help you determine the best configuration.`,
        },
        {
          q: `Does Maxindo LED serve the Tangerang and Jakarta area?`,
          a: `Yes. We provide rental and installation of equipment for ${name} events across Tangerang, Jakarta, and surrounding areas, complete with a technical crew and operator.`,
        },
        {
          q: `How do I get a price quote?`,
          a: `Simply contact us via WhatsApp with your ${name} event details, such as the date, location, and estimated guest count. We will send you a free, transparent quote.`,
        },
      ];

const base = Astro.site ?? SITE.url;
const crumbs = [
  { name: copy.home, url: new URL(localizedPath(lang, '/'), base).href },
  { name: copy.events, url: new URL(localizedPath(lang, '/events'), base).href },
  {
    name,
    url: new URL(localizedPath(lang, `/events/${slug}`), base).href,
  },
];
---

<Base title={title} description={description} lang={lang}>
  <Breadcrumb slot="head" items={crumbs} />
  <FaqPage slot="head" faqs={faqs} />

  <article class="container-x py-16 md:py-24">
    <nav aria-label="Breadcrumb" class="mb-8 text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a class="transition-colors hover:text-accent" href={localizedPath(lang, '/')}>
            {copy.home}
          </a>
        </li>
        <li aria-hidden="true" class="opacity-40">/</li>
        <li>
          <a class="transition-colors hover:text-accent" href={localizedPath(lang, '/events')}>
            {copy.events}
          </a>
        </li>
        <li aria-hidden="true" class="opacity-40">/</li>
        <li class="text-white">{name}</li>
      </ol>
    </nav>

    <div class="overflow-hidden rounded-2xl border border-white/10">
      <Image
        src={entry.data.image}
        alt={name}
        width={1280}
        height={520}
        class="h-56 w-full object-cover md:h-80"
      />
    </div>

    <header class="mt-10 max-w-3xl">
      <h1
        class="bg-accent-grad bg-clip-text text-4xl font-extrabold leading-tight text-transparent md:text-5xl"
      >
        {name}
      </h1>
      <p class="mt-5 text-lg text-muted">{description}</p>
    </header>

    <div
      class="prose-event mt-10 max-w-3xl space-y-5 text-base leading-relaxed text-slate-200"
    >
      <Content />
    </div>

    <section class="mt-14 max-w-3xl">
      <h2 class="text-2xl font-bold text-white">{copy.recommendedHeading}</h2>
      <p class="mt-3 text-muted">{copy.recommendedIntro}</p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <a
          href={localizedPath(lang, '/services')}
          class="group flex items-center justify-between gap-3 rounded-xl border border-white/10 bg-surface px-5 py-4 transition-colors hover:border-accent"
        >
          <span class="font-semibold text-white transition-colors group-hover:text-accent">
            {copy.services}
          </span>
          <span
            aria-hidden="true"
            class="text-accent opacity-60 transition-all group-hover:translate-x-0.5 group-hover:opacity-100"
          >
            &rarr;
          </span>
        </a>
        <a
          href={localizedPath(lang, '/equipment')}
          class="group flex items-center justify-between gap-3 rounded-xl border border-white/10 bg-surface px-5 py-4 transition-colors hover:border-accent"
        >
          <span class="font-semibold text-white transition-colors group-hover:text-accent">
            {copy.equipment}
          </span>
          <span
            aria-hidden="true"
            class="text-accent opacity-60 transition-all group-hover:translate-x-0.5 group-hover:opacity-100"
          >
            &rarr;
          </span>
        </a>
      </div>
    </section>

    <section class="mt-14 max-w-3xl">
      <h2 class="text-2xl font-bold text-white">{copy.faqHeading}</h2>
      <dl class="mt-6 space-y-4">
        {
          faqs.map((faq) => (
            <div class="rounded-xl border border-white/10 bg-surface p-6">
              <dt class="font-semibold text-white">{faq.q}</dt>
              <dd class="mt-2 text-muted">{faq.a}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <div
      class="mt-16 rounded-2xl border border-white/10 bg-surface p-8 md:flex md:items-center md:justify-between md:gap-8"
    >
      <div class="max-w-xl">
        <h2 class="text-2xl font-bold text-white">{copy.ctaHeading}</h2>
        <p class="mt-2 text-muted">{copy.ctaText}</p>
      </div>
      <div class="mt-6 md:mt-0 md:shrink-0">
        <WhatsAppButton lang={lang} message={copy.waMessage} />
      </div>
    </div>
  </article>
</Base>
