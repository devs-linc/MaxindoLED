---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import LocalBusiness from '../../components/schema/LocalBusiness.astro';
import Hero from '../../components/Hero.astro';
import ClientMarquee from '../../components/ClientMarquee.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import EventTile from '../../components/EventTile.astro';
import Testimonials from '../../components/Testimonials.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { useTranslations, localizedPath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'id' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

// --- Content collections (filtered + sorted for this locale) ---
const slugOf = (id: string) => id.slice(lang.length + 1);

const services = (await getCollection('services'))
  .filter((e) => e.id.startsWith(lang + '/'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const equipment = (await getCollection('equipment'))
  .filter((e) => e.id.startsWith(lang + '/'))
  .sort((a, b) => a.data.name.localeCompare(b.data.name))
  .slice(0, 4);

const eventTypes = (await getCollection('eventTypes')).filter((e) =>
  e.id.startsWith(lang + '/')
);

// --- Localized microcopy ---
const copy =
  lang === 'id'
    ? {
        trust: 'Dipercaya oleh ratusan event organizer, perusahaan, dan pasangan di seluruh Jabodetabek',
        servicesEyebrow: 'Layanan',
        servicesTitle: 'Layanan Kami',
        servicesIntro:
          'Solusi audio visual lengkap dalam satu tangan, mulai dari layar LED, sound system, hingga lighting dan multimedia. Tim teknisi kami menangani semuanya dari awal sampai bongkar pasang.',
        statsEyebrow: 'Rekam Jejak',
        statsTitle: 'Angka yang Berbicara',
        statsIntro:
          'Pengalaman bertahun-tahun melayani beragam acara di seluruh Jabodetabek dengan kualitas yang konsisten.',
        statEvents: 'Acara Sukses',
        statYears: 'Tahun Pengalaman',
        statClients: 'Klien Puas',
        equipmentEyebrow: 'Peralatan',
        equipmentTitle: 'Peralatan Unggulan',
        equipmentIntro:
          'Unit terawat dan dikalibrasi rutin, siap untuk acara indoor maupun outdoor. Harga sewa transparan, tanpa biaya tersembunyi.',
        equipmentCta: 'Lihat semua peralatan',
        perDay: '/hari',
        eventsEyebrow: 'Acara',
        eventsTitle: 'Jenis Acara',
        eventsIntro:
          'Dari konser megah hingga wedding intim, kami punya pengalaman dan perlengkapan untuk setiap momen.',
        galleryEyebrow: 'Portofolio',
        galleryTitle: 'Lihat Hasil Kerja Kami',
        galleryIntro:
          'Ratusan acara telah kami sukseskan. Jelajahi portofolio kami untuk melihat kualitas instalasi LED screen dan tata panggung Maxindo LED.',
        galleryCta: 'Lihat Portofolio',
        testimonialsEyebrow: 'Testimoni',
        testimonialsTitle: 'Apa Kata Klien Kami',
        testimonialsIntro:
          'Kepuasan klien adalah prioritas kami. Berikut pengalaman mereka bekerja sama dengan Maxindo LED.',
        ctaTitle: 'Siap Membuat Acara Anda Berkesan?',
        ctaIntro:
          'Konsultasi gratis dan penawaran harga terbaik. Tim kami siap membantu menentukan paket LED screen dan audio visual yang paling sesuai untuk venue serta anggaran Anda.',
        meta: 'Sewa LED screen, videotron, sound system & lighting profesional di Tangerang & Jakarta. Harga bersahabat, teknisi berpengalaman, unit terawat. Konsultasi gratis.',
      }
    : {
        trust: 'Trusted by hundreds of event organizers, companies, and couples across Greater Jakarta',
        servicesEyebrow: 'Services',
        servicesTitle: 'Our Services',
        servicesIntro:
          'Complete audio visual solutions under one roof, from LED screens and sound systems to lighting and multimedia. Our crew handles everything from planning to teardown.',
        statsEyebrow: 'Track Record',
        statsTitle: 'Numbers That Speak',
        statsIntro:
          'Years of experience serving a wide range of events across Greater Jakarta with consistent quality.',
        statEvents: 'Events Delivered',
        statYears: 'Years of Experience',
        statClients: 'Happy Clients',
        equipmentEyebrow: 'Equipment',
        equipmentTitle: 'Featured Equipment',
        equipmentIntro:
          'Well-maintained, regularly calibrated units ready for indoor and outdoor events. Transparent rental pricing with no hidden fees.',
        equipmentCta: 'Browse all equipment',
        perDay: '/day',
        eventsEyebrow: 'Events',
        eventsTitle: 'Event Types',
        eventsIntro:
          'From grand concerts to intimate weddings, we have the experience and gear for every occasion.',
        galleryEyebrow: 'Portfolio',
        galleryTitle: 'See Our Work',
        galleryIntro:
          'We have powered hundreds of events. Explore our portfolio to see the quality of Maxindo LED screen installations and stage production.',
        galleryCta: 'View Portfolio',
        testimonialsEyebrow: 'Testimonials',
        testimonialsTitle: 'What Our Clients Say',
        testimonialsIntro:
          'Client satisfaction is our priority. Here is what they say about working with Maxindo LED.',
        ctaTitle: 'Ready to Make Your Event Unforgettable?',
        ctaIntro:
          'Free consultation and our best price offer. Our team is ready to help you choose the LED screen and audio visual package that fits your venue and budget.',
        meta: 'Professional LED screen, videotron, sound system & lighting rental in Tangerang & Jakarta. Friendly pricing, experienced technicians, well-kept units. Free quote.',
      };

const ctaMessage =
  lang === 'id'
    ? 'Halo Maxindo LED, saya mau konsultasi dan minta penawaran harga untuk acara saya.'
    : 'Hello Maxindo LED, I would like a consultation and a price quote for my event.';

const title = `${t('hero.title')} | Maxindo LED`;
const description = copy.meta;
---

<Base title={title} description={description} lang={lang}>
  <LocalBusiness slot="head" />

  <!-- HERO -->
  <Hero lang={lang} title={t('hero.title')} subtitle={t('hero.subtitle')} />

  <!-- CLIENT LOGO MARQUEE -->
  <ClientMarquee lang={lang} />

  <!-- SERVICES -->
  {
    services.length > 0 && (
      <section class="bg-white py-16 md:py-24">
        <div class="container-x">
          <div class="flex flex-col items-center text-center">
            <span class="eyebrow">{copy.servicesEyebrow}</span>
            <h2 class="section-title mt-4">{copy.servicesTitle}</h2>
            <p class="lead mx-auto mt-4 max-w-2xl text-center">
              {copy.servicesIntro}
            </p>
          </div>
          <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {services.map((e) => (
              <ServiceCard
                href={localizedPath(lang, '/services/' + slugOf(e.id))}
                title={e.data.name}
                summary={e.data.description}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- STATS BAND -->
  <section class="bg-cream py-16 md:py-24">
    <div class="container-x">
      <div class="flex flex-col items-center text-center">
        <span class="eyebrow">{copy.statsEyebrow}</span>
        <h2 class="section-title mt-4">{copy.statsTitle}</h2>
        <p class="lead mx-auto mt-4 max-w-2xl text-center">{copy.statsIntro}</p>
      </div>
      <div class="mx-auto mt-12 grid max-w-4xl grid-cols-1 gap-6 sm:grid-cols-3">
        <div class="card flex flex-col items-center p-8 text-center">
          <span class="text-4xl font-extrabold text-accent md:text-5xl">500+</span>
          <span class="mt-2 font-semibold text-ink">{copy.statEvents}</span>
        </div>
        <div class="card flex flex-col items-center p-8 text-center">
          <span class="text-4xl font-extrabold text-accent md:text-5xl">10+</span>
          <span class="mt-2 font-semibold text-ink">{copy.statYears}</span>
        </div>
        <div class="card flex flex-col items-center p-8 text-center">
          <span class="text-4xl font-extrabold text-accent md:text-5xl">100+</span>
          <span class="mt-2 font-semibold text-ink">{copy.statClients}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURED EQUIPMENT -->
  {
    equipment.length > 0 && (
      <section class="bg-surface py-16 md:py-24">
        <div class="container-x">
          <div class="flex flex-col items-center text-center">
            <span class="eyebrow">{copy.equipmentEyebrow}</span>
            <h2 class="section-title mt-4">{copy.equipmentTitle}</h2>
            <p class="lead mx-auto mt-4 max-w-2xl text-center">
              {copy.equipmentIntro}
            </p>
            <a
              href={localizedPath(lang, '/equipment')}
              class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-accent hover:underline"
            >
              {copy.equipmentCta} <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
          <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {equipment.map((e) => (
              <a
                href={localizedPath(lang, '/equipment')}
                class="card group flex flex-col overflow-hidden transition-colors hover:border-accent"
              >
                <div class="aspect-[4/3] overflow-hidden bg-surface">
                  <Image
                    src={e.data.image}
                    alt={e.data.name}
                    widths={[400, 800]}
                    sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
                <div class="flex flex-1 flex-col p-4">
                  <span class="text-xs font-medium uppercase tracking-wide text-accent">
                    {e.data.category}
                  </span>
                  <h3 class="mt-1 font-bold text-ink">{e.data.name}</h3>
                  <p class="mt-3 text-sm font-semibold text-muted">
                    Rp {e.data.pricePerDay.toLocaleString('id-ID')}
                    {copy.perDay}
                  </p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- CALCULATOR CTA -->
  <section class="container-x py-10 md:py-14">
    <div class="overflow-hidden rounded-3xl border border-line bg-cream p-8 md:p-12">
      <div class="flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
        <div class="max-w-xl">
          <span class="icon-badge amber mb-4">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="11" x2="8.01" y2="11"/><line x1="12" y1="11" x2="12.01" y2="11"/><line x1="16" y1="11" x2="16.01" y2="11"/><line x1="8" y1="15" x2="8.01" y2="15"/><line x1="12" y1="15" x2="12.01" y2="15"/><line x1="16" y1="15" x2="16" y2="18"/><line x1="8" y1="18" x2="12" y2="18"/></svg>
          </span>
          <h2 class="section-title">{lang === 'id' ? 'Hitung Estimasi Biaya Sewa' : 'Estimate Your Rental Cost'}</h2>
          <p class="lead mt-3">{lang === 'id' ? 'Gunakan kalkulator sewa kami untuk memperkirakan biaya peralatan acara Anda dalam hitungan detik, lalu kirim penawarannya langsung ke WhatsApp.' : 'Use our rental calculator to estimate your event equipment cost in seconds, then send the quote straight to WhatsApp.'}</p>
        </div>
        <a class="btn-primary shrink-0" href={localizedPath(lang, '/calculator')}>
          {lang === 'id' ? 'Buka Kalkulator' : 'Open Calculator'}
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- EVENT TYPES -->
  {
    eventTypes.length > 0 && (
      <section class="bg-white py-16 md:py-24">
        <div class="container-x">
          <div class="flex flex-col items-center text-center">
            <span class="eyebrow">{copy.eventsEyebrow}</span>
            <h2 class="section-title mt-4">{copy.eventsTitle}</h2>
            <p class="lead mx-auto mt-4 max-w-2xl text-center">
              {copy.eventsIntro}
            </p>
          </div>
          <div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {eventTypes.map((e) => (
              <EventTile
                href={localizedPath(lang, '/events/' + slugOf(e.id))}
                title={e.data.name}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- GALLERY TEASER -->
  <section class="bg-surface py-16 md:py-24">
    <div class="container-x flex flex-col items-center text-center">
      <span class="eyebrow">{copy.galleryEyebrow}</span>
      <h2 class="section-title mt-4">{copy.galleryTitle}</h2>
      <p class="lead mx-auto mt-4 max-w-2xl text-center">{copy.galleryIntro}</p>
      <a href={localizedPath(lang, '/portfolio')} class="btn-ghost mt-8">
        {copy.galleryCta} <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="bg-white py-16 md:py-24">
    <div class="container-x">
      <div class="flex flex-col items-center text-center">
        <span class="eyebrow">{copy.testimonialsEyebrow}</span>
        <h2 class="section-title mt-4">{copy.testimonialsTitle}</h2>
        <p class="lead mx-auto mt-4 max-w-2xl text-center">
          {copy.testimonialsIntro}
        </p>
      </div>
      <div class="mt-12">
        <Testimonials lang={lang} />
      </div>
    </div>
  </section>

  <!-- FINAL CTA BAND -->
  <section class="bg-white py-16 md:py-24">
    <div class="container-x">
      <div
        class="relative overflow-hidden rounded-[2rem] border border-line bg-cream p-8 text-center md:p-16"
      >
        <div
          aria-hidden="true"
          class="pointer-events-none absolute -top-24 -right-16 h-72 w-72 rounded-full bg-accent-grad opacity-20 blur-3xl"
        >
        </div>
        <div class="relative mx-auto max-w-2xl">
          <h2 class="section-title text-ink">
            {copy.ctaTitle}
          </h2>
          <p class="lead mx-auto mt-4 max-w-xl text-center">{copy.ctaIntro}</p>
          <div class="mt-8 flex justify-center">
            <WhatsAppButton lang={lang} message={ctaMessage} />
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
