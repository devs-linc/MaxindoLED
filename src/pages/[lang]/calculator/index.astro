---
import Base from '../../../layouts/Base.astro';
import Calculator from '../../../components/islands/Calculator';
import { localizedPath } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'id' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;

const copy = {
  id: {
    title: 'Kalkulator Sewa Peralatan | Maxindo LED',
    description:
      'Hitung perkiraan biaya sewa LED screen, sound system, lighting, dan peralatan acara lainnya secara instan, lalu kirim penawaran via WhatsApp.',
    eyebrow: 'Estimasi Cepat',
    h1: 'Kalkulator Sewa Peralatan',
    intro:
      'Pilih peralatan yang Anda butuhkan, atur jumlah dan durasi sewa, lalu lihat perkiraan total secara langsung. Setelah siap, kirim daftar penawaran ke tim kami melalui WhatsApp untuk konfirmasi ketersediaan dan harga final.',
    note:
      'Catatan: angka di atas hanya perkiraan berdasarkan harga harian standar dan belum termasuk transport, instalasi, atau diskon paket. Penawaran final akan kami kirimkan via WhatsApp.',
    breadcrumbHome: 'Beranda',
    breadcrumbCurrent: 'Kalkulator Sewa',
  },
  en: {
    title: 'Equipment Rental Calculator | Maxindo LED',
    description:
      'Instantly estimate the rental cost of LED screens, sound systems, lighting, and other event gear, then send your quote via WhatsApp.',
    eyebrow: 'Quick Estimate',
    h1: 'Equipment Rental Calculator',
    intro:
      'Pick the equipment you need, set quantities and rental duration, and watch the estimated total update live. When you are ready, send the itemized quote to our team on WhatsApp to confirm availability and the final price.',
    note:
      'Note: the figures above are an estimate based on standard daily rates and exclude transport, installation, and package discounts. We will send the final quote via WhatsApp.',
    breadcrumbHome: 'Home',
    breadcrumbCurrent: 'Rental Calculator',
  },
}[lang];
---

<Base title={copy.title} description={copy.description} lang={lang}>
  <section class="container-x py-16 md:py-24">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted">
      <a href={localizedPath(lang, '/')} class="hover:text-accent">{copy.breadcrumbHome}</a>
      <span class="px-2 text-muted">/</span>
      <span class="text-body">{copy.breadcrumbCurrent}</span>
    </nav>

    <div class="max-w-2xl">
      <span class="eyebrow">{copy.eyebrow}</span>
      <h1 class="section-title mt-5">
        {copy.h1}
      </h1>
      <p class="lead mt-5">{copy.intro}</p>
    </div>

    <div class="mt-10 max-w-3xl">
      <div class="card p-6 md:p-8">
        <Calculator client:load lang={lang} />
      </div>
      <p class="mt-4 text-sm text-muted">{copy.note}</p>
    </div>
  </section>
</Base>
