---
import Base from '../../layouts/Base.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import LocalBusiness from '../../components/schema/LocalBusiness.astro';
import Breadcrumb from '../../components/schema/Breadcrumb.astro';
import { SITE, waLink } from '../../consts';
import { useTranslations, localizedPath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'id' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const copy = {
  id: {
    title: 'Kontak Maxindo LED | Sewa LED Screen & Audio Visual',
    description:
      'Hubungi Maxindo LED untuk penyewaan layar LED, sound system, dan multimedia di Tangerang & Jakarta. WhatsApp, telepon, email, dan alamat lengkap kami.',
    breadcrumbHome: 'Beranda',
    breadcrumbContact: 'Kontak',
    eyebrow: 'Hubungi Kami',
    h1: 'Mari Bicarakan Acara Anda',
    lead:
      'Punya rencana acara dalam waktu dekat? Tim Maxindo LED siap membantu Anda memilih layar LED, sound system, dan peralatan multimedia yang tepat sesuai konsep, lokasi, dan anggaran. Cara tercepat untuk mendapat penawaran adalah lewat WhatsApp — kami biasanya membalas dalam hitungan menit pada jam kerja. Anda juga bisa menelepon, mengirim email, atau mengisi formulir di bawah ini, dan kami akan menghubungi Anda kembali secepatnya. Kami melayani area Tangerang, Jakarta, dan sekitarnya, baik untuk acara korporat, pernikahan, konser, peluncuran produk, maupun acara komunitas. Beri tahu kami tanggal, lokasi, dan kebutuhan teknis acara Anda agar kami dapat menyiapkan rekomendasi paket dan estimasi harga yang paling sesuai untuk Anda.',
    napTitle: 'Informasi Kontak',
    addressLabel: 'Alamat',
    whatsappLabel: 'WhatsApp',
    phoneLabel: 'Telepon',
    emailLabel: 'Email',
    hoursTitle: 'Jam Operasional',
    hoursValue: 'Senin – Minggu, 08.00 – 22.00 WIB',
    hoursNote: 'Buka setiap hari, termasuk akhir pekan dan hari libur.',
    socialTitle: 'Ikuti Kami',
    mapTitle: 'Peta lokasi Maxindo LED',
    mapHeading: 'Lokasi Kami',
    formTitle: 'Kirim Permintaan Penawaran',
    formIntro:
      'Lebih suka tidak menggunakan WhatsApp? Isi formulir singkat ini dan tim kami akan menghubungi Anda kembali.',
    nameLabel: 'Nama',
    waNumberLabel: 'Nomor WhatsApp',
    dateLabel: 'Tanggal Acara',
    messageLabel: 'Pesan / Kebutuhan',
    messagePlaceholder:
      'Ceritakan jenis acara, lokasi, dan peralatan yang Anda butuhkan...',
    submit: 'Kirim Permintaan',
    primaryTitle: 'Cara Tercepat: WhatsApp',
    primaryText:
      'Untuk respons paling cepat dan penawaran instan, chat langsung dengan tim kami di WhatsApp.',
    waMessage:
      'Halo Maxindo LED, saya ingin meminta penawaran untuk penyewaan peralatan acara.',
  },
  en: {
    title: 'Contact Maxindo LED | LED Screen & Audio Visual Rental',
    description:
      'Get in touch with Maxindo LED for LED screen, sound system, and multimedia rental in Tangerang & Jakarta. WhatsApp, phone, email, and our full address.',
    breadcrumbHome: 'Home',
    breadcrumbContact: 'Contact',
    eyebrow: 'Get In Touch',
    h1: "Let's Talk About Your Event",
    lead:
      "Planning an event soon? The Maxindo LED team is ready to help you choose the right LED screens, sound systems, and multimedia equipment to match your concept, venue, and budget. The fastest way to get a quote is via WhatsApp — we usually reply within minutes during working hours. You can also call us, send an email, or fill in the form below, and we will get back to you as soon as possible. We serve Tangerang, Jakarta, and the surrounding areas for corporate events, weddings, concerts, product launches, and community gatherings alike. Just let us know the date, location, and technical requirements of your event so we can prepare the package recommendations and price estimate that fit you best.",
    napTitle: 'Contact Information',
    addressLabel: 'Address',
    whatsappLabel: 'WhatsApp',
    phoneLabel: 'Phone',
    emailLabel: 'Email',
    hoursTitle: 'Opening Hours',
    hoursValue: 'Monday – Sunday, 08:00 – 22:00 (WIB)',
    hoursNote: 'Open every day, including weekends and public holidays.',
    socialTitle: 'Follow Us',
    mapTitle: 'Map showing the location of Maxindo LED',
    mapHeading: 'Our Location',
    formTitle: 'Send a Quote Request',
    formIntro:
      'Prefer not to use WhatsApp? Fill in this short form and our team will get back to you.',
    nameLabel: 'Name',
    waNumberLabel: 'WhatsApp Number',
    dateLabel: 'Event Date',
    messageLabel: 'Message / Requirements',
    messagePlaceholder:
      'Tell us your event type, location, and the equipment you need...',
    submit: 'Send Request',
    primaryTitle: 'Fastest Way: WhatsApp',
    primaryText:
      'For the quickest response and an instant quote, chat directly with our team on WhatsApp.',
    waMessage:
      'Hello Maxindo LED, I would like to request a quote for event equipment rental.',
  },
}[lang];

const fullAddress = `${SITE.address.street}, ${SITE.address.locality}, ${SITE.address.region} ${SITE.address.postalCode}`;
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(fullAddress)}&output=embed`;

const breadcrumbItems = [
  { name: copy.breadcrumbHome, url: new URL(localizedPath(lang, '/'), SITE.url).href },
  { name: copy.breadcrumbContact, url: new URL(localizedPath(lang, '/contact'), SITE.url).href },
];

const phoneHref = `tel:${SITE.phoneDisplay.replace(/[^+\d]/g, '')}`;
const emailHref = `mailto:${SITE.email}`;
const waHref = waLink(copy.waMessage);

const socials = [
  { label: 'Instagram', href: SITE.social.instagram },
  { label: 'Facebook', href: SITE.social.facebook },
  { label: 'TikTok', href: SITE.social.tiktok },
  { label: 'YouTube', href: SITE.social.youtube },
];
---

<Base title={copy.title} description={copy.description} lang={lang}>
  <LocalBusiness slot="head" />
  <Breadcrumb slot="head" items={breadcrumbItems} />

  <!-- Intro -->
  <section class="container-x py-16 md:py-24">
    <div class="max-w-3xl">
      <span class="eyebrow">{copy.eyebrow}</span>
      <h1 class="section-title mt-5">{copy.h1}</h1>
      <p class="lead mt-5">{copy.lead}</p>
    </div>

    <!-- Two-column: contact details + enquiry form -->
    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      <!-- Left: NAP card -->
      <div class="card flex flex-col p-6 md:p-8">
        <h2 class="text-xl font-bold text-ink">{copy.napTitle}</h2>
        <dl class="mt-6 space-y-6">
          <div class="flex gap-4">
            <span class="icon-badge amber shrink-0" aria-hidden="true">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </span>
            <div>
              <dt class="text-sm font-semibold uppercase tracking-wide text-accent-2">
                {copy.addressLabel}
              </dt>
              <dd class="mt-1 text-body">
                <address class="not-italic leading-relaxed">
                  {SITE.address.street}<br />
                  {SITE.address.locality}<br />
                  {SITE.address.region} {SITE.address.postalCode}
                </address>
              </dd>
            </div>
          </div>

          <div class="flex gap-4">
            <span class="icon-badge green shrink-0" aria-hidden="true">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" />
              </svg>
            </span>
            <div>
              <dt class="text-sm font-semibold uppercase tracking-wide text-accent-2">
                {copy.whatsappLabel}
              </dt>
              <dd class="mt-1">
                <a
                  class="text-body transition-colors hover:text-accent"
                  rel="nofollow"
                  target="_blank"
                  href={waHref}
                >
                  {SITE.phoneDisplay}
                </a>
              </dd>
            </div>
          </div>

          <div class="flex gap-4">
            <span class="icon-badge blue shrink-0" aria-hidden="true">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3 5a2 2 0 0 1 2-2h3.28a1 1 0 0 1 .95.68l1.5 4.5a1 1 0 0 1-.5 1.21l-2.26 1.13a11 11 0 0 0 5 5l1.13-2.26a1 1 0 0 1 1.21-.5l4.5 1.5a1 1 0 0 1 .68.95V19a2 2 0 0 1-2 2A16 16 0 0 1 3 5Z" />
              </svg>
            </span>
            <div>
              <dt class="text-sm font-semibold uppercase tracking-wide text-accent-2">
                {copy.phoneLabel}
              </dt>
              <dd class="mt-1">
                <a class="text-body transition-colors hover:text-accent" href={phoneHref}>
                  {SITE.phoneDisplay}
                </a>
              </dd>
            </div>
          </div>

          <div class="flex gap-4">
            <span class="icon-badge pink shrink-0" aria-hidden="true">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </svg>
            </span>
            <div>
              <dt class="text-sm font-semibold uppercase tracking-wide text-accent-2">
                {copy.emailLabel}
              </dt>
              <dd class="mt-1">
                <a class="text-body transition-colors hover:text-accent" href={emailHref}>
                  {SITE.email}
                </a>
              </dd>
            </div>
          </div>

          <div class="flex gap-4">
            <span class="icon-badge violet shrink-0" aria-hidden="true">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10" />
                <path d="M12 6v6l4 2" />
              </svg>
            </span>
            <div>
              <dt class="text-sm font-semibold uppercase tracking-wide text-accent-2">
                {copy.hoursTitle}
              </dt>
              <dd class="mt-1 text-body">
                <span class="font-semibold text-ink">{copy.hoursValue}</span>
                <span class="mt-1 block text-sm text-muted">{copy.hoursNote}</span>
              </dd>
            </div>
          </div>
        </dl>

        <!-- Socials -->
        <div class="mt-8 border-t border-line pt-6">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-accent-2">
            {copy.socialTitle}
          </h3>
          <ul class="mt-3 flex flex-wrap gap-2">
            {
              socials.map((s) => (
                <li>
                  <a
                    class="btn-ghost text-sm"
                    rel="noopener"
                    target="_blank"
                    href={s.href}
                  >
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Prominent WhatsApp CTA -->
        <div class="mt-8 rounded-2xl bg-cream p-6">
          <h3 class="text-lg font-bold text-ink">{copy.primaryTitle}</h3>
          <p class="mt-1 text-body">{copy.primaryText}</p>
          <div class="mt-4">
            <WhatsAppButton lang={lang} message={copy.waMessage} />
          </div>
        </div>
      </div>

      <!-- Right: Enquiry form card -->
      <div class="card flex flex-col p-6 md:p-8">
        <h2 class="text-xl font-bold text-ink">{copy.formTitle}</h2>
        <p class="mt-2 text-body">{copy.formIntro}</p>

        {/* TODO: Replace `your-id` with the real Formspree form ID before going live. */}
        <form
          class="mt-6 space-y-5"
          action="https://formspree.io/f/your-id"
          method="POST"
        >
          <div>
            <label class="block text-sm font-semibold text-ink" for="name">
              {copy.nameLabel}
            </label>
            <input
              class="mt-1.5 w-full rounded-xl border border-line bg-surface px-4 py-3 text-ink placeholder:text-muted outline-none transition-colors focus:border-accent"
              id="name"
              name="name"
              type="text"
              required
            />
          </div>
          <div>
            <label class="block text-sm font-semibold text-ink" for="whatsapp">
              {copy.waNumberLabel}
            </label>
            <input
              class="mt-1.5 w-full rounded-xl border border-line bg-surface px-4 py-3 text-ink placeholder:text-muted outline-none transition-colors focus:border-accent"
              id="whatsapp"
              name="whatsapp"
              type="tel"
              inputmode="tel"
              required
            />
          </div>
          <div>
            <label class="block text-sm font-semibold text-ink" for="event-date">
              {copy.dateLabel}
            </label>
            <input
              class="mt-1.5 w-full rounded-xl border border-line bg-surface px-4 py-3 text-ink placeholder:text-muted outline-none transition-colors focus:border-accent"
              id="event-date"
              name="event_date"
              type="date"
            />
          </div>
          <div>
            <label class="block text-sm font-semibold text-ink" for="message">
              {copy.messageLabel}
            </label>
            <textarea
              class="mt-1.5 w-full rounded-xl border border-line bg-surface px-4 py-3 text-ink placeholder:text-muted outline-none transition-colors focus:border-accent"
              id="message"
              name="message"
              rows="4"
              placeholder={copy.messagePlaceholder}
              required></textarea>
          </div>
          <button class="btn-accent w-full justify-center" type="submit">
            {copy.submit}
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- Map -->
  <section class="bg-surface py-16 md:py-24">
    <div class="container-x">
      <h2 class="section-title">{copy.mapHeading}</h2>
      <div class="mt-6 overflow-hidden rounded-2xl border border-line shadow-sm">
        <iframe
          src={mapSrc}
          title={copy.mapTitle}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          width="100%"
          height="420"
          style="border:0; display:block;"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>
</Base>
