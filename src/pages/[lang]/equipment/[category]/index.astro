---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../../../layouts/Base.astro';
import WhatsAppButton from '../../../../components/WhatsAppButton.astro';
import Breadcrumb from '../../../../components/schema/Breadcrumb.astro';
import { localizedPath } from '../../../../i18n/utils';
import type { Lang } from '../../../../i18n/ui';
import { categorySlug } from "../../../../utils/slug";


export async function getStaticPaths() {
  const all = await getCollection('equipment');
  const langs: Lang[] = ['id', 'en'];
  const paths: {
    params: { lang: Lang; category: string };
    props: { categoryName: string };
  }[] = [];

  for (const lang of langs) {
    const items = all.filter((e) => e.id.startsWith(`${lang}/`));
    const seen = new Map<string, string>();
    for (const e of items) {
      const slug = categorySlug(e.data.category);
      if (!seen.has(slug)) seen.set(slug, e.data.category);
    }
    for (const [slug, categoryName] of seen) {
      paths.push({
        params: { lang, category: slug },
        props: { categoryName },
      });
    }
  }

  return paths;
}

const lang = Astro.params.lang as Lang;
const categoryParam = Astro.params.category as string;
const { categoryName } = Astro.props;

const all = await getCollection('equipment');
const items = all
  .filter((e) => e.id.startsWith(`${lang}/`))
  .filter((e) => categorySlug(e.data.category) === categoryParam)
  .sort((a, b) => a.data.pricePerDay - b.data.pricePerDay);

function itemSlug(id: string): string {
  return id.slice(lang.length + 1);
}

const copy = {
  id: {
    home: 'Beranda',
    equipment: 'Peralatan',
    intro: `Pilihan ${categoryName.toLowerCase()} berkualitas untuk disewa harian. Klik tiap unit untuk melihat spesifikasi lengkap.`,
    perDay: '/ hari',
    cta: 'Tanyakan ketersediaan dan paket sewa.',
    waMessage: `Halo Maxindo LED, saya tertarik menyewa peralatan kategori ${categoryName}.`,
    detail: 'Lihat detail',
  },
  en: {
    home: 'Home',
    equipment: 'Equipment',
    intro: `Quality ${categoryName.toLowerCase()} options available for daily rental. Click any unit to see full specifications.`,
    perDay: '/ day',
    cta: 'Ask about availability and rental packages.',
    waMessage: `Hello Maxindo LED, I am interested in renting equipment in the ${categoryName} category.`,
    detail: 'View details',
  },
}[lang];

const priceLabel = (price: number) =>
  lang === 'id'
    ? `Rp ${price.toLocaleString('id-ID')} ${copy.perDay}`
    : `Rp ${price.toLocaleString('id-ID')} ${copy.perDay}`;

const title = `Sewa ${categoryName} | Maxindo LED`;
const titleEn = `${categoryName} Rental | Maxindo LED`;
const pageTitle = lang === 'id' ? title : titleEn;
const description = copy.intro;

const crumbs = [
  { name: copy.home, url: new URL(localizedPath(lang, '/'), Astro.site).toString() },
  {
    name: copy.equipment,
    url: new URL(localizedPath(lang, '/equipment'), Astro.site).toString(),
  },
  {
    name: categoryName,
    url: new URL(
      localizedPath(lang, `/equipment/${categoryParam}`),
      Astro.site
    ).toString(),
  },
];
---

<Base title={pageTitle} description={description} lang={lang}>
  <Breadcrumb slot="head" items={crumbs} />

  <section class="container-x py-16 md:py-24">
    <nav class="mb-8 text-sm text-muted" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a class="hover:text-accent" href={localizedPath(lang, '/')}>
            {copy.home}
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a class="hover:text-accent" href={localizedPath(lang, '/equipment')}>
            {copy.equipment}
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="text-ink">{categoryName}</li>
      </ol>
    </nav>

    <div class="max-w-3xl">
      <span class="eyebrow">{copy.equipment}</span>
      <h1 class="section-title mt-5">{categoryName}</h1>
      <p class="lead mt-4">{copy.intro}</p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item) => (
          <a
            href={localizedPath(lang, `/equipment/${categoryParam}/${itemSlug(item.id)}`)}
            class="card group flex flex-col overflow-hidden transition hover:border-accent hover:shadow-md"
          >
            <div class="aspect-[4/3] overflow-hidden rounded-t-[var(--radius-card)] bg-surface">
              <Image
                src={item.data.image}
                alt={item.data.name}
                widths={[400, 800]}
                sizes="(max-width:768px) 100vw, 400px"
                class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
              />
            </div>
            <div class="flex flex-1 flex-col p-5">
              <h2 class="text-lg font-bold text-ink group-hover:text-accent">
                {item.data.name}
              </h2>
              <p class="mt-3 text-accent font-bold">
                {priceLabel(item.data.pricePerDay)}
              </p>
              <p class="mt-2 flex-1 text-sm text-body line-clamp-3">
                {item.data.description}
              </p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-accent">
                {copy.detail}
                <span aria-hidden="true">&rarr;</span>
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <div
      class="card mt-14 bg-cream p-8 md:flex md:items-center md:justify-between md:gap-8"
    >
      <p class="max-w-xl text-body">{copy.cta}</p>
      <div class="mt-6 shrink-0 md:mt-0">
        <WhatsAppButton lang={lang} message={copy.waMessage} />
      </div>
    </div>
  </section>
</Base>
