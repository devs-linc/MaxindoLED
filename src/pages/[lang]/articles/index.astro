---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import Breadcrumb from '../../../components/schema/Breadcrumb.astro';
import { localizedPath } from '../../../i18n/utils';
import { SITE } from '../../../consts';
import type { Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'id' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;

const articles = (await getCollection('articles'))
  .filter((e) => e.id.startsWith(lang + '/'))
  .sort((a, b) => b.data.datePublished.getTime() - a.data.datePublished.getTime())
  .map((e) => ({ ...e, slug: e.id.slice(lang.length + 1) }));

const dateLocale = lang === 'id' ? 'id-ID' : 'en-US';
const fmtDate = (d: Date) =>
  d.toLocaleDateString(dateLocale, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

const copy =
  lang === 'id'
    ? {
        kicker: 'Artikel & Wawasan',
        title: 'Tips Audio Visual & LED Screen',
        intro:
          'Panduan praktis seputar penyewaan LED screen, sound system, dan tata produksi acara. Kami berbagi pengalaman lapangan agar acara Anda berjalan lancar dan tampil maksimal.',
        read: 'Baca selengkapnya',
        empty: 'Belum ada artikel.',
        home: 'Beranda',
        articles: 'Artikel',
        ctaTitle: 'Punya pertanyaan untuk acara Anda?',
        ctaIntro:
          'Tim Maxindo LED siap membantu menentukan paket LED screen dan audio visual yang paling sesuai. Konsultasi gratis tanpa kewajiban.',
        meta: 'Tips dan panduan penyewaan LED screen, audio visual, dan produksi acara dari Maxindo LED di Tangerang & Jakarta.',
      }
    : {
        kicker: 'Articles & Insights',
        title: 'Audio Visual & LED Screen Tips',
        intro:
          'Practical guides on LED screen rental, sound systems, and event production. We share field experience so your event runs smoothly and looks its best.',
        read: 'Read more',
        empty: 'No articles yet.',
        home: 'Home',
        articles: 'Articles',
        ctaTitle: 'Questions about your event?',
        ctaIntro:
          'The Maxindo LED team is ready to help you choose the right LED screen and audio visual package. Free, no-obligation consultation.',
        meta: 'Tips and guides on LED screen rental, audio visual, and event production from Maxindo LED in Tangerang & Jakarta.',
      };

const title = `${copy.title} | Maxindo LED`;

const breadcrumbItems = [
  { name: copy.home, url: new URL(localizedPath(lang, '/'), SITE.url).href },
  {
    name: copy.articles,
    url: new URL(localizedPath(lang, '/articles'), SITE.url).href,
  },
];
---

<Base title={title} description={copy.meta} lang={lang}>
  <Breadcrumb slot="head" items={breadcrumbItems} />

  <section class="container-x py-16 md:py-24">
    <nav aria-label="Breadcrumb" class="mb-8 text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a href={localizedPath(lang, '/')} class="hover:text-accent">{copy.home}</a>
        </li>
        <li aria-hidden="true" class="text-white/30">/</li>
        <li class="text-white/70">{copy.articles}</li>
      </ol>
    </nav>

    <div class="max-w-2xl">
      <span
        class="inline-block rounded-full border border-accent/40 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-accent"
      >
        {copy.kicker}
      </span>
      <h1 class="mt-5 text-4xl font-extrabold leading-tight md:text-5xl">
        {copy.title}
      </h1>
      <p class="mt-5 text-lg text-muted">{copy.intro}</p>
    </div>

    {
      articles.length === 0 ? (
        <p class="mt-12 text-muted">{copy.empty}</p>
      ) : (
        <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {articles.map((article) => (
            <a
              href={localizedPath(lang, '/articles/' + article.slug)}
              class="group flex flex-col overflow-hidden rounded-xl border border-white/10 bg-surface transition-colors hover:border-accent"
            >
              <div class="aspect-[16/9] overflow-hidden bg-bg">
                <Image
                  src={article.data.cover}
                  alt={article.data.title}
                  widths={[400, 800]}
                  sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </div>
              <div class="flex flex-1 flex-col p-5">
                <time
                  datetime={article.data.datePublished.toISOString()}
                  class="text-xs font-medium uppercase tracking-wide text-accent"
                >
                  {fmtDate(article.data.datePublished)}
                </time>
                <h2 class="mt-2 text-lg font-bold text-white transition-colors group-hover:text-accent">
                  {article.data.title}
                </h2>
                <p class="mt-3 flex-1 text-sm text-muted">
                  {article.data.excerpt}
                </p>
                <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-accent">
                  {copy.read} <span aria-hidden="true">&rarr;</span>
                </span>
              </div>
            </a>
          ))}
        </div>
      )
    }
  </section>

  <section class="border-t border-white/10">
    <div class="container-x py-16 md:py-24">
      <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-surface p-8 md:p-14">
        <div
          aria-hidden="true"
          class="pointer-events-none absolute -top-24 -right-16 h-72 w-72 rounded-full bg-accent-grad opacity-20 blur-3xl"
        >
        </div>
        <div class="relative max-w-2xl">
          <h2 class="bg-accent-grad bg-clip-text text-3xl font-extrabold text-transparent md:text-4xl">
            {copy.ctaTitle}
          </h2>
          <p class="mt-4 text-muted">{copy.ctaIntro}</p>
          <div class="mt-8">
            <WhatsAppButton lang={lang} />
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
