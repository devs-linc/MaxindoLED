---
interface Props {
  faqs: { q: string; a: string }[];
}

const { faqs } = Astro.props;

const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
