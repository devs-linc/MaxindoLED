---
interface Props {
  href: string;
  title: string;
}

const { href, title } = Astro.props;
---

<a
  href={href}
  class="card group flex items-center justify-between gap-3 px-5 py-4 transition hover:border-accent hover:shadow-md"
>
  <span class="font-semibold text-ink transition-colors group-hover:text-accent">
    {title}
  </span>
  <span
    aria-hidden="true"
    class="text-accent opacity-60 transition-all group-hover:translate-x-0.5 group-hover:opacity-100"
  >
    &rarr;
  </span>
</a>
