---
interface Props {
  href: string;
  title: string;
  summary: string;
}

const { href, title, summary } = Astro.props;
---

<a
  href={href}
  class="card group flex h-full flex-col p-6 transition hover:border-accent hover:shadow-md"
>
  <span class="icon-badge amber" aria-hidden="true">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2" y="4" width="20" height="13" rx="2" />
      <path d="M8 21h8M12 17v4" />
    </svg>
  </span>
  <h3 class="mt-4 text-lg font-bold text-ink transition-colors group-hover:text-accent">
    {title}
  </h3>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-body">
    {summary}
  </p>
  <span
    class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-accent"
  >
    <span class="opacity-70 transition-opacity group-hover:opacity-100">
      &rarr;
    </span>
  </span>
</a>
