---
interface Props {
  href: string;
  title: string;
  summary: string;
}

const { href, title, summary } = Astro.props;
---

<a
  href={href}
  class="group flex h-full flex-col rounded-xl border border-white/10 bg-surface p-6 transition-colors hover:border-accent"
>
  <h3 class="text-lg font-bold text-white transition-colors group-hover:text-accent">
    {title}
  </h3>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">
    {summary}
  </p>
  <span
    class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-accent"
  >
    <span class="opacity-70 transition-opacity group-hover:opacity-100">
      &rarr;
    </span>
  </span>
</a>
