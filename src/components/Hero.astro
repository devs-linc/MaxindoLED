---
import WhatsAppButton from './WhatsAppButton.astro';
import { localizedPath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  subtitle: string;
}

const { lang, title, subtitle } = Astro.props;

const eyebrow = lang === 'id' ? 'Tangerang & Jakarta' : 'Tangerang & Jakarta';
const browseLabel = lang === 'id' ? 'Lihat Peralatan' : 'Browse Equipment';
---

<section class="relative overflow-hidden border-b border-white/10">
  <!-- Glowing accent blobs (pure CSS, no external image) -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-32 -right-24 h-96 w-96 rounded-full bg-accent-grad opacity-20 blur-3xl"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-40 -left-32 h-[28rem] w-[28rem] rounded-full opacity-10 blur-3xl"
    style="background: radial-gradient(closest-side, var(--color-accent-2), transparent);"
  >
  </div>

  <div class="container-x relative py-20 md:py-32">
    <div class="max-w-3xl">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-accent/40 bg-surface/60 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-accent"
      >
        <span class="inline-block h-2 w-2 rounded-full bg-accent"></span>
        {eyebrow}
      </span>

      <h1
        class="mt-6 bg-accent-grad bg-clip-text text-4xl font-extrabold leading-tight text-transparent md:text-6xl"
      >
        {title}
      </h1>

      <p class="mt-6 max-w-2xl text-lg text-muted md:text-xl">
        {subtitle}
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-4">
        <WhatsAppButton lang={lang} />
        <a
          href={localizedPath(lang, '/equipment')}
          class="inline-flex items-center gap-2 rounded-lg border border-white/20 px-5 py-3 text-sm font-semibold text-white transition-colors hover:border-accent hover:text-accent"
        >
          {browseLabel}
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</section>
