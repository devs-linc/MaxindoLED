---
import WhatsAppButton from './WhatsAppButton.astro';
import { localizedPath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  subtitle: string;
}

const { lang, title, subtitle } = Astro.props;

const eyebrow = lang === 'id' ? 'Tangerang & Jakarta' : 'Tangerang & Jakarta';
const browseLabel = lang === 'id' ? 'Lihat Peralatan' : 'Browse Equipment';
---

<section class="relative overflow-hidden border-b border-line bg-white">
  <div class="container-x relative grid items-center gap-12 py-16 md:grid-cols-2 md:py-24">
    <!-- Left: copy + CTAs -->
    <div class="max-w-xl">
      <span class="eyebrow">{eyebrow}</span>

      <h1
        class="mt-6 text-4xl font-extrabold leading-tight text-ink md:text-6xl"
      >
        {title}
      </h1>

      <p class="lead mt-6 max-w-xl">
        {subtitle}
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-4">
        <WhatsAppButton lang={lang} />
        <a href={localizedPath(lang, '/equipment')} class="btn-ghost">
          {browseLabel}
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <!-- Right: friendly rounded visual panel (pure CSS LED-screen motif) -->
    <div
      aria-hidden="true"
      class="relative overflow-hidden rounded-3xl bg-cream p-6 md:p-10"
    >
      <!-- soft amber blob -->
      <div
        class="pointer-events-none absolute -top-16 -right-16 h-64 w-64 rounded-full bg-accent-grad opacity-30 blur-3xl"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-20 -left-12 h-56 w-56 rounded-full opacity-25 blur-3xl"
        style="background: radial-gradient(closest-side, var(--color-accent-2), transparent);"
      >
      </div>

      <!-- LED-screen motif -->
      <div class="relative">
        <div class="rounded-2xl border border-line bg-white p-3 shadow-sm">
          <div
            class="grid aspect-video grid-cols-12 grid-rows-7 gap-1 overflow-hidden rounded-xl p-2"
            style="background: linear-gradient(135deg, #1c1f27, #2a2f3a);"
          >
            {
              Array.from({ length: 84 }).map((_, i) => (
                <span
                  class="rounded-[3px]"
                  style={`background: ${[
                    'var(--color-accent)',
                    'var(--color-accent-2)',
                    '#ffffff',
                  ][i % 3]}; opacity: ${0.25 + ((i * 7) % 10) / 13};`}
                />
              ))
            }
          </div>
        </div>
        <!-- stand -->
        <div class="mx-auto mt-3 h-2 w-24 rounded-full bg-line"></div>
        <div class="mx-auto mt-1 h-6 w-1.5 rounded-full bg-line"></div>
      </div>
    </div>
  </div>
</section>
