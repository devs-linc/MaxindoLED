---
import type { Lang } from '../i18n/ui';
import logos from '../data/client-logos.json';

interface Props { lang: Lang }
const { lang } = Astro.props;

// 127 client logos sliced from maxindoled.com, backgrounds removed — split into 3 belts.
const list = logos as string[];
const belts: string[][] = [[], [], []];
list.forEach((l, i) => belts[i % 3].push(l));

const heading = lang === 'id'
  ? 'Dipercaya oleh 100+ brand & instansi ternama'
  : 'Trusted by 100+ leading brands & institutions';
const sub = lang === 'id'
  ? 'Dari kementerian dan BUMN hingga perusahaan multinasional — mereka mempercayakan acaranya pada Maxindo LED.'
  : 'From ministries and state enterprises to multinational companies — they trust their events to Maxindo LED.';
const alt = lang === 'id' ? 'Logo klien Maxindo LED' : 'Maxindo LED client logo';
---

<section class="bg-surface py-14 md:py-20">
  <div class="container-x">
    <div class="mx-auto mb-9 max-w-2xl text-center">
      <h2 class="text-2xl font-bold text-ink md:text-3xl">{heading}</h2>
      <p class="mt-3 text-body">{sub}</p>
    </div>

    <div class="space-y-3">
    {belts.map((belt, i) => (
      <div class="belt">
        <div class={`belt-track${i % 2 === 1 ? ' rev' : ''}`} style={`--dur:${34 + i * 6}s`}>
          {[...belt, ...belt].map((src) => (
            <span class="chip"><img src={src} alt={alt} loading="lazy" decoding="async" /></span>
          ))}
        </div>
      </div>
    ))}
    </div>
  </div>
</section>

<style>
  .belt {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }
  .belt-track {
    display: flex;
    width: max-content;
    align-items: center;
    animation: belt-left var(--dur, 55s) linear infinite;
  }
  .belt-track.rev { animation-name: belt-right; }
  .belt:hover .belt-track { animation-play-state: paused; }
  .chip {
    display: inline-flex; align-items: center; justify-content: center;
    height: 64px; min-width: 128px; padding: 0 20px; margin-right: 14px;
    background: #fff; border: 1px solid var(--color-line); border-radius: 12px; flex: none;
    box-shadow: 0 1px 2px rgba(16, 24, 40, .06);
  }
  .chip img { max-height: 36px; max-width: 130px; width: auto; height: auto; display: block; }
  @keyframes belt-left { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @keyframes belt-right { from { transform: translateX(-50%); } to { transform: translateX(0); } }
</style>
